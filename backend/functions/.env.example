# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Bold Payment Gateway
BOLD_API_KEY=your-bold-api-key
BOLD_API_SECRET=your-bold-api-secret
BOLD_PUBLIC_KEY=your-bold-public-key
BOLD_WEBHOOK_SECRET=your-bold-webhook-secret
BOLD_ENVIRONMENT=sandbox  # sandbox | production

# App
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://tickets.app
